# Configuração pública do Firebase Web (Vite expõe apenas variáveis com prefixo VITE_).
# Copie para .env.local e preencha com os valores do Console do Firebase.
# NUNCA versione o arquivo .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Controle de ambiente (DEV-00.6.2) — definidos por ambiente na Vercel.
# VITE_APP_ENV: valores permitidos "test" (Preview/develop) ou "production" (Production/main).
# VITE_EXPECTED_FIREBASE_PROJECT_ID: ID do projeto Firebase esperado para o ambiente;
# deve ser idêntico a VITE_FIREBASE_PROJECT_ID. Não versionar IDs reais.
VITE_APP_ENV=
VITE_EXPECTED_FIREBASE_PROJECT_ID=
