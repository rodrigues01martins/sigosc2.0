{
  "name": "sigosc-2.0",
  "private": true,
  "version": "0.0.5",
  "description": "SIGOSC 2.0 — Sistema de Gestão de Parcerias com Organizações da Sociedade Civil",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --test \"src/**/*.test.ts\"",
    "test:ui": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-sigosc-rules \"node --test --test-concurrency=1 tests/rules/*.test.ts\"",
    "test:auth": "firebase emulators:exec --only auth,firestore --project demo-sigosc-auth \"node --test --test-concurrency=1 tests/auth/*.test.ts\"",
    "test:server": "firebase emulators:exec --only auth,firestore --project demo-sigosc-server \"node --test --test-concurrency=1 tests/server/*.test.ts\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "firebase-tools": "^15.36.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
