rules_version = '2';

// SIGOSC 2.0 — DEV-00.8: política inicial de NEGAÇÃO INTEGRAL (Cloud Firestore).
//
// - Nenhum acesso pelo SDK cliente: leitura (get/list), criação, atualização e exclusão negadas.
// - Abrange todos os documentos, em qualquer profundidade ({document=**}).
// - Estar autenticado NÃO concede acesso. Não há regras temporárias abertas.
// - Regras por OSC, parceria ou usuário (Multi-Tenant) serão definidas em evolução futura.
// - O Admin SDK (servidor) ignora estas regras; ele não é usado no frontend.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
