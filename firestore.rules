rules_version = '2';

// SIGOSC 2.0 — Security Rules do Cloud Firestore.
//
// DEV-00.8: política de NEGAÇÃO INTEGRAL por padrão (mantida).
// DEV-01.3: SEM novas exceções. Permissões e delegação ficam no próprio vínculo
//   (lido pelo dono pela regra abaixo). Concessão, revogação e delegação ocorrem
//   SOMENTE pelo servidor (/api/osc-permissions, Admin SDK) — nenhuma escrita pelo cliente.
//   A relação de usuários da OSC é fornecida pelo servidor, não por estas regras.
// DEV-01.2: exceções MÍNIMAS de LEITURA para a estrutura Multi-Tenant:
//   oscs/{oscId}                → lida somente por membro com vínculo ATIVO.
//   oscs/{oscId}/members/{uid}  → cada usuário lê apenas o PRÓPRIO vínculo (ativo ou inativo).
// DEV-02.1: exceção MÍNIMA de LEITURA para parcerias:
//   oscs/{oscId}/partnerships/{id} → get/list somente com canConsult(oscId, 'partnerships.view').
//   Nenhuma escrita pelo cliente: cadastro ('partnerships.create') e correção cadastral
//   ('partnerships.edit') ocorrem SOMENTE pelo servidor (/api/osc-partnerships, Admin SDK) —
//   DEV-02.1-C01. Eventos de auditoria (partnershipEvents) e marcadores de idempotência
//   (partnershipRequests) permanecem ilegíveis e não graváveis pelo cliente (negação por padrão).
// DEV-02.2: exceção MÍNIMA de LEITURA para o Plano de Trabalho estruturado:
//   oscs/{oscId}/partnerships/{id}/workPlans/{workPlanId} → get/list com canConsult(oscId, 'work-plan.view').
//   Auditoria (workPlanEvents) ilegível; nenhuma escrita pelo cliente.
// DEV-02.2-C01: SEM novas exceções. Correções materiais (DEC-PT-002) são gravadas e o histórico é
//   consultado somente pelo servidor (/api/osc-work-plans), que exige 'work-plan.view'/'work-plan.edit'.
// DEV-02.4: LEITURA de .../workPlans/{workPlanId}/goals/{id} e /indicators/{id} com 'work-plan.view';
//   nenhuma escrita pelo cliente (gravação somente por /api/osc-work-plan-components).
//
// Princípios:
// - Estar autenticado NÃO concede acesso: toda permissão consulta o vínculo autoritativo
//   em oscs/{oscId}/members/{request.auth.uid}. Custom claims NÃO são consideradas.
// - Nenhuma escrita pelo SDK cliente: OSCs, vínculos e administradores são mantidos
//   apenas por operações administrativas confiáveis (Admin SDK no servidor, que ignora estas regras).
// - Sem leitura global de OSCs e sem leitura de vínculos de terceiros.
// - Qualquer caminho não listado continua negado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownMemberPath(oscId) {
      return /databases/$(database)/documents/oscs/$(oscId)/members/$(request.auth.uid);
    }

    // Vínculo ativo e consistente (uid e oscId do documento coincidem com o caminho).
    function isActiveMember(oscId) {
      return signedIn()
        && exists(ownMemberPath(oscId))
        && get(ownMemberPath(oscId)).data.status == 'active'
        && get(ownMemberPath(oscId)).data.uid == request.auth.uid
        && get(ownMemberPath(oscId)).data.oscId == oscId;
    }

    // --- Preparação para os módulos futuros (DEV-01.3) -----------------------------
    // Ainda NÃO usadas por nenhum caminho. Regras de parcerias, financeiro etc. deverão
    // usar hasPermission(oscId, '<modulo>.<capacidade>'), que exige: vínculo ativo,
    // OSC ativa, situação comercial NÃO suspensa e a permissão individual concedida.
    // O administrador NÃO tem permissões operacionais implícitas.
    function oscData(oscId) {
      return get(/databases/$(database)/documents/oscs/$(oscId)).data;
    }

    function canOperate(oscId) {
      return isActiveMember(oscId)
        && oscData(oscId).registrationStatus == 'active'
        && oscData(oscId).commercialStatus != 'suspended';
    }

    function hasPermission(oscId, permission) {
      return canOperate(oscId)
        && get(ownMemberPath(oscId)).data.get('permissions', []).hasAny([permission]);
    }

    // DEV-02.1 — Consulta de módulo. Exige vínculo ativo, OSC ativa e a permissão individual.
    // Na suspensão comercial, somente o administrador único (oscs/{oscId}.administratorUid)
    // mantém a consulta — e ainda assim apenas se possuir a permissão (sem permissões implícitas).
    function canConsult(oscId, permission) {
      return isActiveMember(oscId)
        && oscData(oscId).registrationStatus == 'active'
        && get(ownMemberPath(oscId)).data.get('permissions', []).hasAny([permission])
        && (oscData(oscId).commercialStatus != 'suspended'
            || oscData(oscId).get('administratorUid', null) == request.auth.uid);
    }

    // Negação por padrão (DEV-00.8).
    match /{document=**} {
      allow read, write: if false;
    }

    match /oscs/{oscId} {
      // Dados institucionais mínimos: somente leitura individual (get), nunca listagem.
      allow get: if isActiveMember(oscId);

      match /members/{memberUid} {
        // O próprio vínculo, ativo ou inativo (necessário para exibir a situação).
        allow get: if signedIn() && memberUid == request.auth.uid;
      }

      // DEV-02.1 — Parcerias da OSC: somente LEITURA, isolada pelo caminho da OSC.
      // Escrita negada a todos os clientes (inclusive com permissão concedida).
      match /partnerships/{partnershipId} {
        allow get, list: if canConsult(oscId, 'partnerships.view');

        // DEV-02.2 — Plano de Trabalho estruturado: somente LEITURA com 'work-plan.view'
        // (competência própria). Gravações exclusivamente pelo servidor (/api/osc-work-plans).
        match /workPlans/{workPlanId} {
          allow get, list: if canConsult(oscId, 'work-plan.view');

          // DEV-02.4 — metas e indicadores PREVISTOS da versão: somente LEITURA, mesma competência.
          // Gravações exclusivamente pelo servidor (/api/osc-work-plan-components).
          match /goals/{goalId} {
            allow get, list: if canConsult(oscId, 'work-plan.view');
          }
          match /indicators/{indicatorId} {
            allow get, list: if canConsult(oscId, 'work-plan.view');
          }
        }
      }
    }

    // Consulta dos vínculos do usuário por grupo de coleções:
    //   collectionGroup('members').where('uid', '==', request.auth.uid)
    // A regra só autoriza consultas cujo filtro garante que TODOS os resultados
    // pertencem ao solicitante. O nome de subcoleção "members" é reservado a vínculos.
    match /{path=**}/members/{memberUid} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
